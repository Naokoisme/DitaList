{
  "name": "dida-local",
  "productName": "DitaList",
  "author": "Naoko",
  "version": "0.0.0",
  "private": true,
  "description": "本地清单：离线任务与日历",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node scripts/ui-smoke.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.1.0",
    "playwright": "^1.58.0",
    "rcedit": "^5.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "8.3.5"
  }
}
